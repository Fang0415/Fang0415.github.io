generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  PUBLISHED
}

model Post {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  content      String
  tags         String[]      @default([])
  coverAssetId String?
  coverAsset   Asset?        @relation("PostCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  featured     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        Json
  summary      Json
  content      Json?
  highlights   Json          @default("{\"zh\":[],\"en\":[]}")
  category     String
  tags         String[]      @default([])
  githubUrl    String?
  demoUrl      String?
  coverAssetId String?
  coverAsset   Asset?        @relation("ProjectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  status       ProjectStatus @default(PLANNING)
  featured     Boolean       @default(false)
  visible      Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([visible, featured, sortOrder])
  @@index([status, sortOrder])
}

/// Managed experience records. Previously hardcoded in src/lib/site.ts, which
/// meant editing a job entry required a deploy.
model Experience {
  id         String   @id @default(cuid())
  slug       String   @unique
  company    String
  role       String
  period     String
  summary    String
  highlights String[] @default([])
  stack      String[] @default([])
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, sortOrder])
}

/// Single-row table (id is pinned to "default") holding the persona strings
/// the header, hero, footer and home profile surfaces read.
model SiteProfile {
  id             String   @id @default("default")
  name           String
  wordmark       String
  mark           String
  role           String
  location       String
  hero           String
  lead           String
  email          String
  github         String
  wechat         String   @default("")
  /// Profile introduction: Markdown, blank line = new paragraph.
  aboutIntro     String   @default("")
  /// "标题 | 说明" per entry — the three cards under 关注方向.
  focus          String[] @default([])
  /// Plain labels for the 常用工具 tag cloud.
  tools          String[] @default([])
  /// One bullet per entry under 最近在做.
  now            String[] @default([])
  /// "左栏 | 右栏" per entry — the 一些背景 key/value list.
  background     String[] @default([])
  avatarAssetId  String?
  avatarAsset    Asset?   @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
}

model Asset {
  id             String        @id @default(cuid())
  key            String        @unique
  filename       String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  bucket         String
  publicUrl      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  postCovers     Post[]        @relation("PostCover")
  projectCovers  Project[]     @relation("ProjectCover")
  profileAvatars SiteProfile[] @relation("ProfileAvatar")
}
